POSTGRES_PASSWORD=local-test-password
WEB_PORT=8080
# Set a nonempty local test token before using compose.test.yaml.
TEST_TOKEN=change-this-local-test-token
# Optional API bearer token. Enter in the dashboard when configured.
API_TOKEN=
# Set true to allow public vehicle access while keeping operator logs protected.
PUBLIC_API=false
# Optional independent credential for History > Request log.
OPERATOR_TOKEN=
# Optional browser key for the Google basemap and terrain. Leave empty for coordinate tracking.
VITE_GOOGLE_MAPS_API_KEY=
